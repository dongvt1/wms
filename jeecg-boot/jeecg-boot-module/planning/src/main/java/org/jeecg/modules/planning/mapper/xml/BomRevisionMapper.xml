<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.jeecg.modules.planning.mapper.BomRevisionMapper">

    <select id="selectByBomId" resultType="org.jeecg.modules.planning.entity.BomRevision">
        SELECT * FROM wh_bom_revision WHERE bom_id = #{bomId} ORDER BY create_time DESC
    </select>

</mapper>
