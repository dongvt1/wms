<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.jeecg.modules.warehouse.mapper.BomItemMapper">

    <select id="selectByBomId" resultType="org.jeecg.modules.warehouse.entity.BomItem">
        SELECT bi.*, p.name AS material_name, p.code AS material_code
        FROM wh_bom_item bi
        LEFT JOIN product p ON p.id = bi.material_id
        WHERE bi.bom_id = #{bomId}
    </select>

    <delete id="deleteByBomId">
        DELETE FROM wh_bom_item WHERE bom_id = #{bomId}
    </delete>

</mapper>
