<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.jeecg.modules.warehouse.mapper.ProductionLogMapper">

    <select id="selectByWorkOrderId" resultType="org.jeecg.modules.warehouse.entity.ProductionLog">
        SELECT * FROM wh_production_log WHERE work_order_id = #{workOrderId} ORDER BY log_time DESC
    </select>

</mapper>
