<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cy.modules.warehouse.mapper.StockTransactionMapper">

    <!-- Result Map -->
    <resultMap id="StockTransactionResultMap" type="com.cy.modules.warehouse.entity.StockTransaction">
        <id     column="id"               jdbcType="VARCHAR"   property="id" />
        <result column="create_by"        jdbcType="VARCHAR"   property="createBy" />
        <result column="create_time"      jdbcType="TIMESTAMP" property="createTime" />
        <result column="update_by"        jdbcType="VARCHAR"   property="updateBy" />
        <result column="update_time"      jdbcType="TIMESTAMP" property="updateTime" />
        <result column="sys_org_code"     jdbcType="VARCHAR"   property="sysOrgCode" />
        <result column="transaction_code" jdbcType="VARCHAR"   property="transactionCode" />
        <result column="transaction_type" jdbcType="VARCHAR"   property="transactionType" />
        <result column="transaction_date" jdbcType="TIMESTAMP" property="transactionDate" />
        <result column="status"           jdbcType="INTEGER"   property="status" />
        <result column="created_by"       jdbcType="VARCHAR"   property="createdBy" />
        <result column="approved_by"      jdbcType="VARCHAR"   property="approvedBy" />
        <result column="approved_at"      jdbcType="TIMESTAMP" property="approvedAt" />
        <result column="notes"            jdbcType="VARCHAR"   property="notes" />
    </resultMap>

    <!-- Get transactions by date range -->
    <select id="getByDateRange" parameterType="map" resultMap="StockTransactionResultMap">
        SELECT * FROM stock_transactions 
        WHERE transaction_date BETWEEN #{startDate} AND #{endDate} 
        ORDER BY transaction_date DESC
    </select>

    <!-- Get transactions by status -->
    <select id="getByStatus" parameterType="java.lang.String" resultMap="StockTransactionResultMap">
        SELECT * FROM stock_transactions 
        WHERE status = #{status} 
        ORDER BY transaction_date DESC
    </select>

    <!-- Get transactions by type -->
    <select id="getByTransactionType" parameterType="java.lang.String" resultMap="StockTransactionResultMap">
        SELECT * FROM stock_transactions 
        WHERE transaction_type = #{transactionType} 
        ORDER BY transaction_date DESC
    </select>

    <!-- Get transaction summary report -->
    <select id="getTransactionSummary" resultMap="StockTransactionResultMap">
        SELECT st.*, 
               (SELECT COUNT(*) FROM stock_transaction_items WHERE transaction_id = st.id) as item_count 
        FROM stock_transactions st 
        ORDER BY st.transaction_date DESC
    </select>

    <!-- Get transaction by code -->
    <select id="getByCode" parameterType="java.lang.String" resultMap="StockTransactionResultMap">
        SELECT * FROM stock_transactions 
        WHERE transaction_code = #{transactionCode}
    </select>

</mapper>