<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cy.modules.common.mapper.BomItemMapper">

    <resultMap id="BomItemRM" type="com.cy.modules.common.entity.BomItem">
        <id     property="id"                  column="id" />
        <result property="bomId"               column="bom_id" />
        <result property="materialId"          column="material_id" />
        <result property="childBomId"          column="child_bom_id" />
        <result property="itemType"            column="item_type" />
        <result property="quantity"            column="quantity" />
        <result property="unit"                column="unit" />
        <result property="purchaseLeadTimeDays" column="purchase_lead_time_days" />
        <result property="wastageRate"         column="wastage_rate" />
        <result property="notes"               column="notes" />
        <result property="refDesignators"      column="ref_designators" />
        <!-- Join fields từ material -->
        <result property="materialName"        column="material_name" />
        <result property="materialCode"        column="material_code" />
    </resultMap>

    <select id="selectByBomId" resultMap="BomItemRM">
        SELECT bi.*, m.name AS material_name, m.code AS material_code
        FROM pl_bom_item bi
        LEFT JOIN material m ON m.id = bi.material_id
        WHERE bi.bom_id = #{bomId}
        ORDER BY bi.item_type ASC
    </select>

    <select id="selectBomItemsWithChildren" resultType="java.util.Map">
        SELECT bi.*,
               m.name    AS material_name,
               m.code    AS material_code,
               cb.bom_code AS child_bom_code,
               cb.bom_name AS child_bom_name
        FROM pl_bom_item bi
        LEFT JOIN material m  ON m.id  = bi.material_id
        LEFT JOIN pl_bom  cb ON cb.id = bi.child_bom_id
        WHERE bi.bom_id = #{bomId}
        ORDER BY bi.item_type ASC
    </select>

    <delete id="deleteByBomId">
        DELETE FROM pl_bom_item WHERE bom_id = #{bomId}
    </delete>

</mapper>
