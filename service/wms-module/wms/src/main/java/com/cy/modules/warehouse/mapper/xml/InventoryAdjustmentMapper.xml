<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cy.modules.warehouse.mapper.InventoryAdjustmentMapper">

    <!-- Result Map -->
    <resultMap id="InventoryAdjustmentResultMap" type="com.cy.modules.warehouse.entity.InventoryAdjustment">
        <id     column="id"                  jdbcType="VARCHAR"   property="id" />
        <result column="create_by"           jdbcType="VARCHAR"   property="createBy" />
        <result column="create_time"         jdbcType="TIMESTAMP" property="createTime" />
        <result column="update_by"           jdbcType="VARCHAR"   property="updateBy" />
        <result column="update_time"         jdbcType="TIMESTAMP" property="updateTime" />
        <result column="sys_org_code"        jdbcType="VARCHAR"   property="sysOrgCode" />
        <result column="product_id"          jdbcType="VARCHAR"   property="productId" />
        <result column="old_quantity"        jdbcType="INTEGER"   property="oldQuantity" />
        <result column="new_quantity"        jdbcType="INTEGER"   property="newQuantity" />
        <result column="adjustment_reason"   jdbcType="VARCHAR"   property="adjustmentReason" />
        <result column="user_id"             jdbcType="VARCHAR"   property="userId" />
        <result column="created_at"          jdbcType="TIMESTAMP" property="createdAt" />
    </resultMap>

    <!-- Adjustment with product info result map -->
    <resultMap id="AdjustmentWithProductResultMap" type="com.cy.modules.warehouse.entity.InventoryAdjustment" extends="InventoryAdjustmentResultMap">
        <result column="product_name" jdbcType="VARCHAR" property="productName" />
        <result column="product_code" jdbcType="VARCHAR" property="productCode" />
    </resultMap>

    <!-- Get adjustments by product ID -->
    <select id="getByProductId" parameterType="java.lang.String" resultMap="InventoryAdjustmentResultMap">
        SELECT * FROM inventory_adjustments WHERE product_id = #{productId} ORDER BY created_at DESC
    </select>

    <!-- Get adjustments by date range -->
    <select id="getByDateRange" resultMap="InventoryAdjustmentResultMap">
        SELECT * FROM inventory_adjustments 
        WHERE created_at BETWEEN #{startDate} AND #{endDate} 
        ORDER BY created_at DESC
    </select>

    <!-- Get adjustments by product ID and date range -->
    <select id="getByProductIdAndDateRange" resultMap="InventoryAdjustmentResultMap">
        SELECT * FROM inventory_adjustments 
        WHERE product_id = #{productId} 
        AND created_at BETWEEN #{startDate} AND #{endDate} 
        ORDER BY created_at DESC
    </select>

    <!-- Get adjustment summary report -->
    <select id="getAdjustmentSummary" resultMap="AdjustmentWithProductResultMap">
        SELECT ia.*, 
               p.name as product_name, 
               p.code as product_code 
        FROM inventory_adjustments ia 
        JOIN product p ON ia.product_id = p.id 
        ORDER BY ia.created_at DESC
    </select>

</mapper>