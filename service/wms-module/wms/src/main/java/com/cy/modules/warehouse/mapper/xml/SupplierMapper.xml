<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cy.modules.warehouse.mapper.SupplierMapper">

    <!-- Result Map -->
    <resultMap id="SupplierResultMap" type="com.cy.modules.warehouse.entity.Supplier">
        <id     column="id"             jdbcType="VARCHAR"   property="id" />
        <result column="create_by"      jdbcType="VARCHAR"   property="createBy" />
        <result column="create_time"    jdbcType="TIMESTAMP" property="createTime" />
        <result column="update_by"      jdbcType="VARCHAR"   property="updateBy" />
        <result column="update_time"    jdbcType="TIMESTAMP" property="updateTime" />
        <result column="sys_org_code"   jdbcType="VARCHAR"   property="sysOrgCode" />
        <result column="supplier_code"  jdbcType="VARCHAR"   property="supplierCode" />
        <result column="supplier_name"  jdbcType="VARCHAR"   property="supplierName" />
        <result column="contact_person" jdbcType="VARCHAR"   property="contactPerson" />
        <result column="phone"          jdbcType="VARCHAR"   property="phone" />
        <result column="email"          jdbcType="VARCHAR"   property="email" />
        <result column="address"        jdbcType="VARCHAR"   property="address" />
        <result column="status"         jdbcType="INTEGER"   property="status" />
    </resultMap>

    <!-- Get supplier by code -->
    <select id="getByCode" parameterType="java.lang.String" resultMap="SupplierResultMap">
        SELECT * FROM suppliers 
        WHERE supplier_code = #{supplierCode}
    </select>

    <!-- Check if supplier code is unique -->
    <select id="countByCodeAndId" parameterType="map" resultType="int">
        SELECT COUNT(*) FROM suppliers 
        WHERE supplier_code = #{supplierCode} AND id != #{id}
    </select>

    <!-- Get active suppliers -->
    <select id="getActiveSuppliers" resultMap="SupplierResultMap">
        SELECT * FROM suppliers 
        WHERE status = 1 
        ORDER BY supplier_name
    </select>

</mapper>