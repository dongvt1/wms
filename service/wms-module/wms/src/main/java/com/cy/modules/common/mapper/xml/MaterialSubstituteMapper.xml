<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cy.modules.common.mapper.MaterialSubstituteMapper">

    <resultMap id="MaterialSubstituteRM" type="com.cy.modules.common.entity.MaterialSubstitute">
        <id     property="id"                   column="id" />
        <result property="materialId"            column="material_id" />
        <result property="substituteMaterialId"  column="substitute_material_id" />
        <result property="priority"              column="priority" />
        <result property="notes"                 column="notes" />
        <result property="createTime"            column="create_time" />
        <result property="updateTime"            column="update_time" />
        <!-- Join fields từ material -->
        <result property="substituteName"        column="substitute_name" />
        <result property="substituteCode"        column="substitute_code" />
        <result property="substituteUnit"        column="substitute_unit" />
    </resultMap>

    <select id="selectByMaterialId" resultMap="MaterialSubstituteRM">
        SELECT ms.*,
               m.name  AS substitute_name,
               m.code  AS substitute_code,
               m.unit  AS substitute_unit
        FROM material_substitute ms
        LEFT JOIN material m ON m.id = ms.substitute_material_id
        WHERE ms.material_id = #{materialId}
        ORDER BY ms.priority ASC
    </select>

    <delete id="deleteByMaterialId">
        DELETE FROM material_substitute WHERE material_id = #{materialId}
    </delete>

</mapper>
